# Environment Configuration for ContentGrid
# Maintained by SPManchester Private Limited (https://spmanchester.com)

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
# Defaults to backend/data/contentgrid.sqlite if not specified
DB_PATH=./backend/data/contentgrid.sqlite

# Security & Session TTL (in hours)
SESSION_TTL_HOURS=720

# Optional CORS Origin (set to specific domain in production)
CORS_ORIGIN=*
